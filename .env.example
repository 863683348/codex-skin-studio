# ===== Firebase（Google 登录）=====
# 在 Firebase 控制台创建项目 → Authentication → 开启 Google 登录 → 项目设置复制配置
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Stripe 支付 =====
# 在 Stripe Dashboard 获取密钥：Developers → API keys
# （服务器端使用，不暴露给前端）
STRIPE_SECRET_KEY=
# Stripe Webhook Secret：在 Stripe Dashboard → Developers → Webhooks 创建端点后获取
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID：Stripe Dashboard → Products → 创建商品后复制对应的 Price ID
# 对应 PricingView 中的 Pro / Team 方案
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_TEAM=

# ===== 部署域名（用于 Stripe Success/Cancel 回调）=====
# 留空时自动使用请求来源域名，通常不需要手动填写
# NEXT_PUBLIC_SITE_URL=
