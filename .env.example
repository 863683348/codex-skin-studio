# ===== Firebase（Google 登录）=====
# 在 Firebase 控制台创建项目 → Authentication → 开启 Google 登录 → 项目设置复制配置
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== PayPal 支付 =====
# PayPal Client ID：在 https://developer.paypal.com/dashboard → Apps & Credentials → REST API apps 获取
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal 订阅计划 ID：PayPal Dashboard → Billing → Plans → 创建订阅计划后复制 ID（格式：P-xxxxxxxxxxxx）
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
NEXT_PUBLIC_PAYPAL_PLAN_TEAM=

# ===== Google AdSense（可选）=====
# 在 https://adsense.google.com 注册网站并获取广告代码中的 publisher ID（格式：ca-pub-xxxxxxxxxxxxxx）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# ===== Gmail 发件（License Key 自动邮件，仅本机脚本用，勿加 NEXT_PUBLIC_）=====
# Gmail 应用专用密码：Google 账户 → 安全性 → 两步验证(需开启) → 应用专用密码 → 生成 16 位
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gmail SMTP 主机（默认 smtp.gmail.com，一般无需改）
GMAIL_SMTP_HOST=smtp.gmail.com

# ===== 服务端（仅 Vercel，勿加 NEXT_PUBLIC_）=====
# Firebase 服务账号：控制台 → 项目设置 → 服务账号 → 生成新私钥 → 取 3 个字段
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# PayPal Webhook ID：开发者后台 → Webhooks → 创建后复制（ID 形如 8PHxxxxx-xxxx-xxxx）
PAYPAL_WEBHOOK_ID=
# 服务端 PayPal 订阅计划 ID（用于 webhook 映射 plan，可与前端 NEXT_PUBLIC_ 相同值）
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_TEAM=
# License Key HMAC 密钥（默认与客户端 license-dream-skin.ps1 内嵌一致；改动需同步客户端）
LICENSE_HMAC_SECRET=
