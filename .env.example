# ===== Firebase（Google 登录）=====
# 在 Firebase 控制台创建项目 → Authentication → 开启 Google 登录 → 项目设置复制配置
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== PayPal 支付 =====
# PayPal Client ID：在 https://developer.paypal.com/dashboard → Apps & Credentials → REST API apps 获取
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal 订阅计划 ID：PayPal Dashboard → Billing → Plans → 创建订阅计划后复制 ID（格式：P-xxxxxxxxxxxx）
NEXT_PUBLIC_PAYPAL_PLAN_PRO=
NEXT_PUBLIC_PAYPAL_PLAN_TEAM=

# ===== Google AdSense（可选）=====
# 在 https://adsense.google.com 注册网站并获取广告代码中的 publisher ID（格式：ca-pub-xxxxxxxxxxxxxx）
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
